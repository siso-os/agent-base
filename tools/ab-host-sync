#!/usr/bin/env bash
# ab-host-sync <sha>: put <sha>'s seat host (services/host) and stack plugin (stack/) into the main checkout, where every
# seat's siso-host runs from (services/host/bin/siso-host execs src/host.ts there). tools/ab-live runs it after ab-switch
# puts web and node live. Why (HARNESS, 12 Oct): since 8 Oct (t-0539) node runs from a release slot, so ab-switch never
# wrote these paths, and five host PRs (#154 #156-#159: lean seats, Haiku team, SDK 0.3.296, carry on after compaction,
# compact at 33%) were "live" on the app while every seat still ran the 10 Oct host.
# Running seats keep the code they loaded; a seat gets the new host when it next starts. Same rule as ab-live: a file is
# rewritten only if it matches HEAD or something that went live before (refs/live history), so nobody's edit is lost;
# any other edit refuses the sync (exit 4) and changes nothing. If services/host/package.json changed, its dependencies
# are installed offline from the store. Exit 0 synced (or nothing to do), 4 refused.
set -euo pipefail
SHA=${1:-}; [ -n "$SHA" ] || { echo "usage: tools/ab-host-sync <sha>" >&2; exit 2; }
M=${AB_LIVE_CHECKOUT:-$HOME/SISO_Workspace/SISO_Agency/apps/siso-internal-labs/siso-internal-labs-agent-base}
STATE=${AB_LIVE_STATE:-$HOME/.local/state/agent-base/live}
cd "$M"
SHA=$(git rev-parse --verify "$SHA^{commit}")
PATHS=(services/host stack pnpm-lock.yaml)
# What went live before: HEAD, refs/host-live, and every sha in the last 60 rows of the live journal.
KNOWN=$( { git rev-parse -q --verify HEAD; git rev-parse -q --verify refs/host-live || true
  [ -f "$STATE/live.jsonl" ] && tail -n 60 "$STATE/live.jsonl" | python3 -c 'import json,sys
for l in sys.stdin:
  try: print(json.loads(l)["sha"])
  except Exception: pass' || true; } | awk '!seen[$0]++' | while read -r s; do git cat-file -e "$s^{commit}" 2>/dev/null && echo "$s"; done)
known() { local f=$1 h; [ -e "$f" ] || return 0; h=$(git hash-object "$f"); for s in $KNOWN; do [ "$(git rev-parse -q --verify "$s:$f" 2>/dev/null)" = "$h" ] && return 0; done; return 1; }
CHANGED=()
while read -r f; do
  [ -n "$f" ] || continue
  git cat-file -e "$SHA:$f" 2>/dev/null || continue   # only files that exist at SHA are written
  [ -e "$f" ] && [ "$(git hash-object "$f")" = "$(git rev-parse "$SHA:$f")" ] && continue
  known "$f" || { echo "ab-host-sync: $f is edited in the checkout (matches nothing that went live); refusing, nothing changed" >&2; exit 4; }
  CHANGED+=("$f")
done < <( { git ls-tree -r --name-only "$SHA" -- "${PATHS[@]}"; } | sort -u)
# Files the last sync put here that SHA deleted go too, if nobody edited them (13 Oct: a moved README stayed behind).
GONE=()
if PREV_HOST=$(git rev-parse -q --verify refs/host-live); then
  while read -r f; do
    [ -n "$f" ] && [ -e "$f" ] && [ "$(git hash-object "$f")" = "$(git rev-parse -q --verify "$PREV_HOST:$f")" ] && GONE+=("$f")
  done < <(git diff --no-renames --name-only --diff-filter=D "$PREV_HOST" "$SHA" -- "${PATHS[@]}")
fi
((${#GONE[@]})) && { git rm -q --cached --ignore-unmatch -- "${GONE[@]}"; rm -f -- "${GONE[@]}"; echo "ab-host-sync: removed ${#GONE[@]} file(s) deleted at ${SHA:0:12}"; }
((${#CHANGED[@]})) || { git update-ref refs/host-live "$SHA"; echo "ab-host-sync: host and stack already at ${SHA:0:12}"; exit 0; }
DEPS=0; printf '%s\n' "${CHANGED[@]}" | grep -qE '^(services/host/package.json|pnpm-lock.yaml)$' && DEPS=1
BAK=$(mktemp -d); NEW=()
for f in "${CHANGED[@]}"; do if [ -e "$f" ]; then mkdir -p "$BAK/$(dirname "$f")"; cp -p "$f" "$BAK/$f"; else NEW+=("$f"); fi; done
git ls-files -s -- "${CHANGED[@]}" > "$BAK/.index"   # the index as it was, so a put-back is exact
# Put files back exactly (content and index); files that did not exist before are removed again.
putback() {
  local f; for f in "$@"; do
    if [ -e "$BAK/$f" ]; then cp -p "$BAK/$f" "$f"; else git rm -q --cached -- "$f" 2>/dev/null || true; rm -f -- "$f"; fi
    git update-index --force-remove -- "$f" 2>/dev/null || true
  done
  grep -F -f <(printf '\t%s\n' "$@") "$BAK/.index" | git update-index --index-info
}
git checkout "$SHA" -- "${CHANGED[@]}"
NOTE=""
if ((DEPS)); then
  # The checkout's other package.json files may not match the lockfile at SHA (it only follows live paths), and pnpm checks
  # every importer even with --filter. Then the host code still goes live on the dependencies it has, and the new
  # dependencies wait (the log says why); host code that needs them must say so in its PR.
  mkdir -p "$STATE"
  if ! pnpm install --frozen-lockfile --offline --filter ./services/host... >"$STATE/host-sync-install.log" 2>&1; then
    putback $(printf '%s\n' "${CHANGED[@]}" | grep -E '^(services/host/package.json|pnpm-lock.yaml)$')
    DEPS=0; NOTE="; dependencies NOT installed, package.json and lockfile left as they were ($STATE/host-sync-install.log)"
    echo "ab-host-sync: offline install for services/host failed: $(grep -m1 ERR_ "$STATE/host-sync-install.log" | cut -c1-160)" >&2
  fi
fi
git update-ref refs/host-live "$SHA"
echo "ab-host-sync: ${#CHANGED[@]} files of services/host and stack at ${SHA:0:12}$( ((DEPS)) && echo ', host dependencies installed'); seats get it when they next start$NOTE"
