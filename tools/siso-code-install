#!/bin/bash
# siso-code-install: put the pinned SISO Code build (T3 Code from sisodias/siso-code) on this laptop and run it. Run by
# ab-switch after each deploy, so SISO Code arrives with the normal update. Shaan, 13 Oct: "t3 code should be on my
# fucking laptop since the OS runs from my laptop and I just have agents running on other stuff".
#   newest laptop-* release   what it runs (the mini publishes one after each build; see siso/README.md in the fork)
#   tools/siso-code.release   the tag to fall back on when GitHub cannot be asked
#   ~/.local/share/siso-code/app/t3   the build (server, its node_modules, web files as dist/client); TAG names it
#   launchd com.siso.code     127.0.0.1:5490, state in ~/.local/state/siso-code
# Idempotent: with the pinned tag installed it only makes sure the server is up. Exit 0 up, 1 failed (old build kept).
set -uo pipefail
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PIN=$(tr -d '[:space:]' < "$HERE/siso-code.release")
SHARE=${SISO_CODE_SHARE:-$HOME/.local/share/siso-code}; APP=$SHARE/app/t3; STATE=$HOME/.local/state/siso-code
AGENTS=$HOME/Library/LaunchAgents; LABEL=com.siso.code; DOMAIN=gui/$(id -u); PORT=5490
NODE=${SISO_CODE_NODE:-$HOME/.local/bin/node}
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
say() { echo "siso-code: $*"; }
# The newest build the mini published (it publishes one after each nightly T3 merge); the pin when GitHub cannot say.
TAG=$(gh release list -R sisodias/siso-code --limit 20 --json tagName,isDraft -q '[.[] | select(.isDraft | not) | .tagName | select(startswith("laptop-"))][0]' 2>/dev/null)
TAG=${TAG:-$PIN}

# The first try ran T3 on the mini behind a tunnel (com.siso.code-tunnel, then com.siso.code-door); retire those.
for old in com.siso.code-door com.siso.code-tunnel; do
  if [ -f "$AGENTS/$old.plist" ]; then
    launchctl bootout "$DOMAIN/$old" 2>/dev/null; mkdir -p "$SHARE/_archive"; mv "$AGENTS/$old.plist" "$SHARE/_archive/"; say "retired $old"
  fi
done

# An upgrade restarts SISO Code, which cuts every running agent turn (15 Oct: 8 installs in a morning). With a build
# already running, a new tag waits until the last install is 2 h old and no thread has an active run, the same rule
# as siso/install-laptop.sh in the fork; SISO_CODE_INSTALL_NOW=1 overrides. Deferred, the old build keeps running.
if [ -f "$APP/TAG" ] && [ "$(cat "$APP/TAG")" != "$TAG" ] && [ -z "${SISO_CODE_INSTALL_NOW:-}" ]; then
  age=$(( $(date +%s) - $(stat -f %m "$APP/TAG") ))
  busy=$(sqlite3 "file:$STATE/userdata/statev2.sqlite?mode=ro" "select count(*) from orchestration_v2_projection_runs r join orchestration_v2_projection_threads t on t.thread_id = r.thread_id where r.status in ('preparing','starting','running','waiting') and t.archived_at is null and t.deleted_at is null" 2>/dev/null || echo 0)
  if (( age < 7200 )); then say "deferred $TAG: last install was $(( age / 60 )) min ago; installs are at most every 2 h"; TAG=$(cat "$APP/TAG")
  elif (( busy > 0 )); then say "deferred $TAG: $busy run(s) active; a restart would cut them"; TAG=$(cat "$APP/TAG"); fi
fi
if [ "$(cat "$APP/TAG" 2>/dev/null)" != "$TAG" ]; then
  tmp=$(mktemp -d)
  # GitHub first; a copy the mini left in downloads/ when GitHub cannot be reached or the login has lapsed.
  if ! gh release download "$TAG" -R sisodias/siso-code -p '*.tar.gz' -D "$tmp" >/dev/null 2>&1; then
    cp "$SHARE/downloads/siso-code-$TAG.tar.gz" "$tmp/" 2>/dev/null \
      || { say "could not download $TAG from GitHub; on this laptop run: gh auth login -h github.com"; exit 1; }
    say "GitHub refused (gh auth login -h github.com fixes it); used the copy in downloads/"
  fi
  mkdir "$tmp/x" && tar -xzf "$tmp"/*.tar.gz -C "$tmp/x" && [ -f "$tmp/x/t3/dist/bin.mjs" ] || { say "$TAG did not unpack"; exit 1; }
  echo "$TAG" > "$tmp/x/t3/TAG"
  if [ -d "$APP" ]; then old="$HOME/.Trash/siso-code-$(date +%s)"; mkdir -p "$old"; mv "$APP" "$old/"; fi
  mkdir -p "$SHARE/app" && mv "$tmp/x/t3" "$APP" && fresh=1
  say "installed $TAG"
fi

mkdir -p "$STATE"
PLIST=$AGENTS/$LABEL.plist
cat > "$PLIST.new" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>$LABEL</string>
<key>ProgramArguments</key><array><string>$NODE</string><string>$APP/dist/bin.mjs</string><string>--host</string><string>127.0.0.1</string>
<string>--port</string><string>$PORT</string><string>--base-dir</string><string>$STATE</string><string>--no-browser</string></array>
<key>WorkingDirectory</key><string>$HOME/SISO_Workspace</string>
<key>EnvironmentVariables</key><dict>
<!-- T3 reads PATH from \$SHELL -ilc at start; an interactive zsh with no terminal hangs, so sh and a PATH here. -->
<key>SHELL</key><string>/bin/sh</string><key>LANG</key><string>en_GB.UTF-8</string>
<key>PATH</key><string>$HOME/.local/bin:$HOME/.claude/bin:$HOME/.npm-global/bin:$HOME/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
</dict>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>$STATE/server.log</string><key>StandardErrorPath</key><string>$STATE/server.log</string>
</dict></plist>
PL
if ! cmp -s "$PLIST.new" "$PLIST"; then
  mv "$PLIST.new" "$PLIST"; launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null
  for _ in $(seq 1 40); do launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1 || break; sleep 0.25; done
  launchctl bootstrap "$DOMAIN" "$PLIST"
else
  mv "$PLIST.new" "$SHARE/.plist-unchanged"
  if [ -n "${fresh:-}" ]; then launchctl kickstart -k "$DOMAIN/$LABEL"
  elif ! launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then launchctl bootstrap "$DOMAIN" "$PLIST"; fi
fi
for _ in $(seq 1 120); do curl -sf -m 2 -o /dev/null "http://127.0.0.1:$PORT/" && { say "$TAG up on 127.0.0.1:$PORT"; exit 0; }; sleep 0.5; done
say "$TAG did not answer on $PORT in 60 s; see $STATE/server.log"; exit 1
