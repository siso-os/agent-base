{
  "name": "siso-internal-labs-agent-base",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "node": "pnpm --filter @agent-base/node start",
    "web": "pnpm --filter @agent-base/web dev",
    "dev:app": "node scripts/dev-app.mjs",
    "build": "pnpm --filter @agent-base/web build",
    "desktop": "pnpm build && cd apps/desktop && cargo tauri build --bundles app",
    "check": "node tools/check-modules.mjs"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@agent-base/web>react": "19.3.0",
      "@agent-base/web>react-dom": "19.3.0",
      "@halo/agent-face>react": "19.3.0",
      "@siso/composer>react": "19.3.0",
      "@siso/composer>react-dom": "19.3.0",
      "@siso/icons>react": "19.3.0",
      "@siso/icons>react-dom": "19.3.0",
      "@siso/os>react": "19.3.0",
      "@siso/shell>react": "19.3.0",
      "@siso/shell>react-dom": "19.3.0",
      "@siso/side-nav>react": "19.3.0",
      "@siso/terminal>react": "19.3.0",
      "@agent-base/voice>react": "19.3.0"
    }
  }
}
